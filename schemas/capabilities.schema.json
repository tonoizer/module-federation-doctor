{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tonoizer/module-federation-doctor/schemas/capabilities.schema.json",
  "title": "MFDoctor CLI capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "commands",
    "formats",
    "schemaVersions",
    "exitCodes",
    "nonInteractive",
    "schemas",
    "nonGoals",
    "completeness",
    "githubAction",
    "networkPolicy",
    "bundlerMatrix"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "@tonoizer/mfdoctor" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "commands": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z-]*$" },
      "additionalProperties": { "$ref": "#/$defs/command" }
    },
    "formats": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["terminal", "json", "sarif"] }
    },
    "schemaVersions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z-]*$" },
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "exitCodes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["0", "1", "2"],
      "properties": {
        "0": { "type": "string", "minLength": 1 },
        "1": { "type": "string", "minLength": 1 },
        "2": { "type": "string", "minLength": 1 }
      }
    },
    "nonInteractive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flags", "commands"],
      "properties": {
        "flags": {
          "type": "array",
          "items": { "type": "string", "pattern": "^--[a-z][a-z-]*$" },
          "uniqueItems": true
        },
        "commands": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z-]*$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "schemas": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z-]*$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\./schemas/[a-z0-9.-]+\\.schema\\.json$"
      }
    },
    "nonGoals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "emit", "workspace", "probe", "runtime"],
      "properties": {
        "check": { "type": "string", "minLength": 1 },
        "emit": { "type": "string", "minLength": 1 },
        "workspace": { "type": "string", "minLength": 1 },
        "probe": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 }
      }
    },
    "githubAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "uses", "pinToTag"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "uses": { "type": "string", "minLength": 1 },
        "pinToTag": { "type": "string", "minLength": 1 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offlineByDefault", "networkCommands", "probe"],
      "properties": {
        "offlineByDefault": { "type": "boolean" },
        "networkCommands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "httpsRequired",
            "httpAllowedForLoopbackInitialUrl",
            "ssrfProtection",
            "blockPrivateLinkLocalMetadataHosts",
            "maxRedirects",
            "defaultTimeoutMs",
            "defaultMaxBytes",
            "neverExecutesRemoteEntry",
            "rejectEmbeddedCredentials"
          ],
          "properties": {
            "httpsRequired": { "type": "boolean" },
            "httpAllowedForLoopbackInitialUrl": { "type": "boolean" },
            "ssrfProtection": { "type": "boolean" },
            "blockPrivateLinkLocalMetadataHosts": { "type": "boolean" },
            "maxRedirects": { "type": "integer", "minimum": 0 },
            "defaultTimeoutMs": { "type": "integer", "minimum": 1 },
            "defaultMaxBytes": { "type": "integer", "minimum": 1 },
            "neverExecutesRemoteEntry": { "type": "boolean" },
            "rejectEmbeddedCredentials": { "type": "boolean" }
          }
        }
      }
    },
    "bundlerMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "supported", "partial", "bundlers", "localCi"],
      "properties": {
        "source": { "const": "./fixtures/compatibility-matrix.json" },
        "supported": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "partial": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "bundlers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bundlerEntry" }
        },
        "localCi": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/localCiCell" }
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "network"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "network": { "type": "boolean" },
        "formats": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["terminal", "json", "sarif"] }
        }
      }
    },
    "bundlerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "adapter"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["supported", "partial"] },
        "adapter": { "type": "string", "minLength": 1 }
      }
    },
    "localCiCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bundler", "fixture"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "bundler": { "type": "string", "minLength": 1 },
        "fixture": { "type": "string", "minLength": 1 },
        "coverage": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
