    },
    {
      "if": { "properties": { "kind": { "const": "application" } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["containerName"] },
            { "required": ["adapterTargetKey"] },
            { "required": ["adapter"] },
            { "required": ["bundler"] },
            { "required": ["bundlerVersion"] },
            { "required": ["target"] },
            { "required": ["mode"] },
            { "required": ["buildEnvironment"] },
            { "required": ["lane"] },
            { "required": ["environment"] },
            { "required": ["buildLineageKey"] },
            { "required": ["buildId"] },
            { "required": ["buildKey"] },
            { "required": ["artifactKind"] },
            { "required": ["digest"] },
            { "required": ["artifactSetDigest"] },
            { "required": ["environmentKey"] },
            { "required": ["deploymentId"] },
            { "required": ["artifactKeys"] },
            { "required": ["deploymentKey"] },
            { "required": ["realm"] },
            { "required": ["realmId"] },
            { "required": ["realmKey"] },
            { "required": ["runtimeInstanceId"] },
            { "required": ["runtimePackage"] },
            { "required": ["runtimeVersion"] },
            { "required": ["occurrenceId"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "container" } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["adapter"] },
            { "required": ["adapterTargetKey"] },
            { "required": ["bundler"] },
            { "required": ["bundlerVersion"] },
            { "required": ["target"] },
            { "required": ["mode"] },
            { "required": ["buildEnvironment"] },
            { "required": ["lane"] },
            { "required": ["environment"] },
            { "required": ["buildLineageKey"] },
            { "required": ["buildId"] },
            { "required": ["buildKey"] },
            { "required": ["artifactKind"] },
            { "required": ["digest"] },
            { "required": ["environmentKey"] },
            { "required": ["deploymentKey"] },
            { "required": ["realm"] },
            { "required": ["realmKey"] },
            { "required": ["runtimeInstanceId"] },
            { "required": ["runtimePackage"] },
            { "required": ["runtimeVersion"] },
            { "required": ["occurrenceId"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "adapter-target" } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["lane"] },
            { "required": ["adapterTargetKey"] },
            { "required": ["environment"] },
            { "required": ["buildLineageKey"] },
            { "required": ["buildId"] },
            { "required": ["buildKey"] },
            { "required": ["artifactKind"] },
            { "required": ["digest"] },
            { "required": ["artifactSetDigest"] },
            { "required": ["environmentKey"] },
            { "required": ["deploymentKey"] },
            { "required": ["realm"] },
            { "required": ["realmKey"] },
            { "required": ["runtimeInstanceId"] },
            { "required": ["runtimePackage"] },
            { "required": ["runtimeVersion"] },
            { "required": ["occurrenceId"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "build-lineage" } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["containerName"] },
            { "required": ["adapter"] },
            { "required": ["bundler"] },
            { "required": ["bundlerVersion"] },
            { "required": ["mode"] },
            { "required": ["buildEnvironment"] },
            { "required": ["buildLineageKey"] },
            { "required": ["buildId"] },
            { "required": ["buildKey"] },
            { "required": ["artifactKind"] },
            { "required": ["digest"] },
            { "required": ["artifactSetDigest"] },
            { "required": ["environmentKey"] },
            { "required": ["deploymentKey"] },
            { "required": ["realm"] },
            { "required": ["realmKey"] },
            { "required": ["runtimeInstanceId"] },
            { "required": ["runtimePackage"] },
            { "required": ["runtimeVersion"] },
            { "required": ["occurrenceId"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "build" } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["organizationId"] },
            { "required": ["adapterTargetKey"] },
            { "required": ["applicationId"] },
            { "required": ["containerName"] },
            { "required": ["adapter"] },
            { "required": ["bundler"] },
            { "required": ["bundlerVersion"] },
            { "required": ["target"] },
            { "required": ["mode"] },
            { "required": ["buildEnvironment"] },
            { "required": ["target"] },
            { "required": ["lane"] },
            { "required": ["environment"] },
            { "required": ["artifactKind"] },
            { "required": ["digest"] },
            { "required": ["artifactSetDigest"] },
            { "required": ["environmentKey"] },
            { "required": ["deploymentKey"] },
            { "required": ["realm"] },
            { "required": ["realmKey"] },
            { "required": ["runtimeInstanceId"] },
            { "required": ["runtimePackage"] },
            { "required": ["runtimeVersion"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "artifact" } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["organizationId"] },
            { "required": ["adapterTargetKey"] },
            { "required": ["applicationId"] },
            { "required": ["containerName"] },
            { "required": ["adapter"] },
            { "required": ["bundler"] },
            { "required": ["bundlerVersion"] },
            { "required": ["mode"] },
            { "required": ["buildEnvironment"] },
            { "required": ["target"] },
            { "required": ["lane"] },
            { "required": ["environment"] },
            { "required": ["buildLineageKey"] },
            { "required": ["buildId"] },
            { "required": ["environmentKey"] },
            { "required": ["deploymentKey"] },
            { "required": ["realm"] },
            { "required": ["realmKey"] },
            { "required": ["runtimeInstanceId"] },
            { "required": ["runtimePackage"] },
            { "required": ["runtimeVersion"] },
            { "required": ["occurrenceId"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "environment" } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["applicationId"] },
            { "required": ["adapterTargetKey"] },
            { "required": ["containerName"] },
            { "required": ["adapter"] },
            { "required": ["bundler"] },
            { "required": ["bundlerVersion"] },
            { "required": ["target"] },
            { "required": ["mode"] },
            { "required": ["buildEnvironment"] },
            { "required": ["target"] },
            { "required": ["lane"] },
            { "required": ["buildLineageKey"] },
            { "required": ["buildId"] },
            { "required": ["buildKey"] },
            { "required": ["artifactKind"] },
            { "required": ["digest"] },
            { "required": ["artifactSetDigest"] },
            { "required": ["deploymentKey"] },
            { "required": ["realm"] },
            { "required": ["realmKey"] },
            { "required": ["runtimeInstanceId"] },
            { "required": ["runtimePackage"] },
            { "required": ["runtimeVersion"] },
            { "required": ["occurrenceId"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "deployment" } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["organizationId"] },
            { "required": ["adapterTargetKey"] },
            { "required": ["applicationId"] },
            { "required": ["containerName"] },
            { "required": ["adapter"] },
            { "required": ["bundler"] },
            { "required": ["bundlerVersion"] },
            { "required": ["target"] },
            { "required": ["mode"] },
            { "required": ["buildEnvironment"] },
            { "required": ["target"] },
            { "required": ["lane"] },
            { "required": ["environment"] },
            { "required": ["buildLineageKey"] },
            { "required": ["buildId"] },
            { "required": ["buildKey"] },
            { "required": ["artifactKind"] },
            { "required": ["digest"] },
            { "required": ["realm"] },
            { "required": ["realmKey"] },
            { "required": ["runtimeInstanceId"] },
            { "required": ["runtimePackage"] },
            { "required": ["runtimeVersion"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "runtime-realm" } } },
      "then": {
