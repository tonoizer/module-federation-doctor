  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\)(?!.*[A-Za-z][A-Za-z\\d+.-]*://)(?!.*[?&](?:(?:[Tt][Oo][Kk][Ee][Nn])|(?:[Ss][Ii][Gg])|(?:[Ss][Ii][Gg][Nn][Aa][Tt][Uu][Rr][Ee])|(?:[Ee][Xx][Pp][Ii][Rr][Ee][Ss])|(?:[Aa][Uu][Tt][Hh])|(?:[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn])|(?:[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd])|(?:[Ss][Ee][Cc][Rr][Ee][Tt])|(?:[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll])|(?:[Ss][Ee][Ss][Ss][Ii][Oo][Nn])|[Kk][Ee][Yy])(?:=|&|$))(?!\\d{4}-\\d{2}-\\d{2}(?:[Tt ]|$))(?!\\d{10,13}$)(?!(?:[Pp][Rr][Oo][Cc][Ee][Ss][Ss]|[Ss][Ee][Ss][Ss][Ii][Oo][Nn]|[Tt][Aa][Bb]|[Pp][Ii][Dd]|[Ss][Ii][Dd])[-_:]).+$"
    },
    "safeShortId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\)(?!.*[A-Za-z][A-Za-z\\d+.-]*://)(?!.*[?&](?:(?:[Tt][Oo][Kk][Ee][Nn])|(?:[Ss][Ii][Gg])|(?:[Ss][Ii][Gg][Nn][Aa][Tt][Uu][Rr][Ee])|(?:[Ee][Xx][Pp][Ii][Rr][Ee][Ss])|(?:[Aa][Uu][Tt][Hh])|(?:[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn])|(?:[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd])|(?:[Ss][Ee][Cc][Rr][Ee][Tt])|(?:[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll])|(?:[Ss][Ee][Ss][Ss][Ii][Oo][Nn])|[Kk][Ee][Yy])(?:=|&|$))(?!\\d{4}-\\d{2}-\\d{2}(?:[Tt ]|$))(?!\\d{10,13}$)(?!(?:[Pp][Rr][Oo][Cc][Ee][Ss][Ss]|[Ss][Ee][Ss][Ss][Ii][Oo][Nn]|[Tt][Aa][Bb]|[Pp][Ii][Dd]|[Ss][Ii][Dd])[-_:]).+$"
    },
    "digest": { "type": "string", "pattern": "^(?:sha256:)?[a-f0-9]{64}$" },
    "organizationKey": { "type": "string", "pattern": "^mfid:v1:organization:[a-f0-9]{24}$" },
    "applicationKey": { "type": "string", "pattern": "^mfid:v1:application:[a-f0-9]{24}$" },
    "containerKey": { "type": "string", "pattern": "^mfid:v1:container:[a-f0-9]{24}$" },
    "adapterTargetKey": { "type": "string", "pattern": "^mfid:v1:adapter-target:[a-f0-9]{24}$" },
    "buildLineageKey": { "type": "string", "pattern": "^mfid:v1:build-lineage:[a-f0-9]{24}$" },
    "buildKey": { "type": "string", "pattern": "^mfid:v1:build:[a-f0-9]{24}$" },
    "artifactKey": { "type": "string", "pattern": "^mfid:v1:artifact:[a-f0-9]{24}$" },
    "environmentKey": { "type": "string", "pattern": "^mfid:v1:environment:[a-f0-9]{24}$" },
    "deploymentKey": { "type": "string", "pattern": "^mfid:v1:deployment:[a-f0-9]{24}$" },
    "realmKey": { "type": "string", "pattern": "^mfid:v1:runtime-realm:[a-f0-9]{24}$" }
  },
  "unevaluatedProperties": false
}
