{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tonoizer/module-federation-doctor/schemas/project.schema.json",
  "title": "MFDoctor project facts",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "bundler",
    "capabilities",
    "dependencies",
    "imports",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "required": ["name", "root"],
      "properties": {
        "name": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "identityKey": {
          "type": "string",
          "pattern": "^mfid:v1:application:[a-f0-9]{24}$"
        },
        "federationGroup": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "bundler": {
      "type": "object",
      "required": ["name", "mode"],
      "properties": {
        "name": {
          "enum": ["vite", "rspack", "rsbuild", "webpack", "modern", "unknown"]
        },
        "version": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "lifecycle": {
          "type": "object",
          "required": ["flavor", "engine", "evidence"],
          "properties": {
            "flavor": {
              "enum": ["vite", "rolldown-vite", "vite-plus"]
            },
            "engine": {
              "enum": ["rollup", "rolldown"]
            },
            "postEmitHook": {
              "enum": ["writeBundle", "closeBundle"]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "moduleFederationPluginCount": {
          "type": "integer",
          "minimum": 0
        },
        "federationInstances": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "pluginName", "configDigest", "registrationGroup"],
            "properties": {
              "id": { "type": "string", "pattern": "^mfid:v1:federation-instance:[a-f0-9]{24}$" },
              "pluginName": { "type": "string", "minLength": 1 },
              "configDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "registrationGroup": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          }
        },
        "outputPublicPathKind": {
          "enum": ["string", "non-string", "auto", "unknown"]
        },
        "viteConfig": {
          "type": "object",
          "properties": {
            "manualChunks": { "type": "boolean" },
            "codeSplittingGroups": { "type": "boolean" },
            "resolveAliases": { "$ref": "#/$defs/stringMap" },
            "serverOrigin": { "type": ["string", "null"] },
            "serverPort": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "transformImportLibraries": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "moduleFederation": {
      "type": "object"
    },
    "federationInstances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "pluginName",
          "configDigest",
          "registrationGroup",
          "moduleFederation",
          "capabilities",
          "imports",
          "artifacts"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^mfid:v1:federation-instance:[a-f0-9]{24}$" },
          "pluginName": { "type": "string", "minLength": 1 },
          "configDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "registrationGroup": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "moduleFederation": { "type": "object" },
          "capabilities": { "$ref": "#/$defs/capabilities" },
          "imports": { "type": "object" },
          "runtimePluginContracts": { "type": "array" },
          "artifacts": { "type": "object" },
          "builds": { "type": "array" }
        },
        "additionalProperties": false
      }
    },
    "federationInstanceId": {
      "type": "string",
      "pattern": "^mfid:v1:federation-instance:[a-f0-9]{24}$"
    },
    "analysis": {
      "$ref": "#/$defs/analysisBudget"
    },
    "dependencies": {
      "type": "object",
      "required": ["declared", "installed"],
      "properties": {
        "declared": {
          "$ref": "#/$defs/stringMap"
        },
        "installed": {
          "$ref": "#/$defs/stringMap"
        }
      },
      "additionalProperties": false
    },
    "imports": {
      "type": "object",
      "required": ["sourceFiles", "specifiers", "packages"],
      "properties": {
        "sourceFiles": {
          "$ref": "#/$defs/stringArray"
        },
        "specifiers": {
          "$ref": "#/$defs/stringArray"
        },
        "packages": {
          "$ref": "#/$defs/stringArray"
        },
        "dynamicPackages": {
          "$ref": "#/$defs/stringArray"
        },
        "remotes": {
          "$ref": "#/$defs/stringArray"
        },
        "unresolvedDynamic": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["api", "file"],
            "properties": {
              "api": {
                "enum": ["import", "loadRemote", "loadShare", "loadShareSync", "registerRemotes"]
              },
              "file": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "sourceReadFailures": {
          "$ref": "#/$defs/stringArray"
        },
        "sourceScope": {
          "enum": ["project", "instance", "partial"]
        },
        "evidenceSources": {
          "type": "array",
          "items": {
            "enum": ["source", "manifest", "runtime-trace"]
          }
        },
        "depth": {
          "enum": ["direct", "local-graph"]
        },
        "deepImports": {
          "$ref": "#/$defs/stringArray"
        },
        "deepImportFiles": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/stringArray"
          }
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": ["emittedAssets"],
      "properties": {
        "manifest": {
          "type": "object"
        },
        "stats": {
          "type": "object"
        },
        "emittedAssets": {
          "$ref": "#/$defs/stringArray"
        },
        "assetSizes": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "additionalProperties": false
    },
    "builds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "adapter",
          "bundler",
          "emittedAssets",
          "artifacts",
          "capabilities",
          "sourceHook"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "adapter": {
            "enum": ["vite", "rspack", "rsbuild", "webpack", "modern", "unknown"]
          },
          "bundler": {
            "enum": ["vite", "rspack", "rsbuild", "webpack", "modern", "unknown"]
          },
          "compilerName": {
            "type": "string"
          },
          "compilationName": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "flavor": {
            "enum": ["vite", "rolldown-vite", "vite-plus"]
          },
          "engine": {
            "enum": ["rollup", "rolldown"]
          },
          "outputRoot": {
            "type": "string"
          },
          "federationInstanceIds": {
            "$ref": "#/$defs/stringArray"
          },
          "emittedAssets": {
            "$ref": "#/$defs/stringArray"
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "effectiveMode": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "targetKind": {
            "enum": ["web", "node", "ssr", "worker", "unknown"]
          },
          "modernContext": {
            "$ref": "#/$defs/modernContext"
          },
          "capabilities": {
            "type": "object",
            "required": ["outputRoot", "emittedAssets", "artifacts", "effectiveMode", "target"],
            "additionalProperties": false,
            "patternProperties": {},
            "properties": {
              "outputRoot": {
                "$ref": "#/$defs/buildCapability"
              },
              "emittedAssets": {
                "$ref": "#/$defs/buildCapability"
              },
              "artifacts": {
                "$ref": "#/$defs/buildCapability"
              },
              "effectiveMode": {
                "$ref": "#/$defs/buildCapability"
              },
              "target": {
                "$ref": "#/$defs/buildCapability"
              }
            }
          },
          "sourceHook": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "runtimePluginContracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["plugin", "kind"],
        "properties": {
          "plugin": {
            "type": "string"
          },
          "kind": {
            "enum": ["invalid-factory", "cors-parity"]
          },
          "reason": {
            "type": "string"
          },
          "confidence": {
            "enum": ["clear", "heuristic"]
          },
          "file": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "buildCapability": {
      "type": "object",
      "required": ["state", "reason"],
      "properties": {
        "state": {
          "enum": ["exact", "partial", "unavailable", "not-applicable"]
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "modernContext": {
      "type": "object",
      "properties": {
        "packageName": { "type": "string" },
        "command": { "type": "string" },
        "metaName": { "type": "string" },
        "bundlerType": { "type": "string" },
        "isProd": { "type": "boolean" },
        "env": { "type": "string" },
        "target": { "type": "string" }
      },
      "additionalProperties": false
    },
    "analysisBudget": {
      "type": "object",
      "required": ["status", "limits", "usage", "exceeded"],
      "properties": {
        "status": {
          "enum": ["complete", "partial", "unknown"]
        },
        "limits": {
          "$ref": "#/$defs/analysisBudgetLimits"
        },
        "usage": {
          "$ref": "#/$defs/analysisBudgetUsage"
        },
        "exceeded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/analysisBudgetExceeded"
          }
        }
      },
      "additionalProperties": false
    },
    "analysisBudgetLimits": {
      "type": "object",
      "required": [
        "maxFiles",
        "maxSourceBytes",
        "maxArtifacts",
        "maxEvidenceNodes",
        "maxSerializedBytes",
        "maxWallTimeMs"
      ],
      "properties": {
        "maxFiles": { "type": "integer", "minimum": 0 },
        "maxSourceBytes": { "type": "integer", "minimum": 0 },
        "maxArtifacts": { "type": "integer", "minimum": 0 },
        "maxEvidenceNodes": { "type": "integer", "minimum": 0 },
        "maxSerializedBytes": { "type": "integer", "minimum": 0 },
        "maxWallTimeMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "analysisBudgetUsage": {
      "type": "object",
      "required": ["files", "sourceBytes", "artifacts", "evidenceNodes", "serializedBytes"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "sourceBytes": { "type": "integer", "minimum": 0 },
        "artifacts": { "type": "integer", "minimum": 0 },
        "evidenceNodes": { "type": "integer", "minimum": 0 },
        "serializedBytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "analysisBudgetExceeded": {
      "type": "object",
      "required": ["kind", "limit"],
      "properties": {
        "kind": {
          "enum": [
            "files",
            "sourceBytes",
            "artifacts",
            "evidenceNodes",
            "serializedBytes",
            "wallTimeMs"
          ]
        },
        "limit": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": [
        "config",
        "sourceImports",
        "manifest",
        "stats",
        "emittedAssets",
        "installedVersions"
      ],
      "properties": {
        "config": {
          "type": "boolean"
        },
        "sourceImports": {
          "type": "boolean"
        },
        "manifest": {
          "type": "boolean"
        },
        "stats": {
          "type": "boolean"
        },
        "emittedAssets": {
          "type": "boolean"
        },
        "installedVersions": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
