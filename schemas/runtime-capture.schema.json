{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tonoizer/module-federation-doctor/schemas/runtime-capture.schema.json",
  "title": "Module Federation Doctor external runtime capture v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractVersion",
    "collector",
    "transport",
    "captureId",
    "capabilities",
    "limits",
    "truncation",
    "reports",
    "events",
    "devtools",
    "snapshots",
    "instances",
    "network",
    "errors",
    "relations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractVersion": { "const": 1 },
    "collector": { "$ref": "#/$defs/nameVersion" },
    "transport": {
      "enum": ["file", "browser-debug", "devtools-export", "node-file", "app-export"]
    },
    "captureId": { "type": "string", "minLength": 1 },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "limits": { "$ref": "#/$defs/limits" },
    "truncation": { "type": "array", "items": { "$ref": "#/$defs/truncation" } },
    "reports": { "$ref": "#/$defs/observabilityRecords" },
    "events": { "$ref": "#/$defs/observabilityEventRecords" },
    "devtools": { "$ref": "#/$defs/devtoolsRecords" },
    "snapshots": { "$ref": "#/$defs/snapshotRecords" },
    "instances": { "$ref": "#/$defs/instanceRecords" },
    "network": { "$ref": "#/$defs/networkRecords" },
    "errors": { "$ref": "#/$defs/errorRecords" },
    "relations": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/relation" } }
  },
  "additionalProperties": false,
  "$defs": {
    "nameVersion": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["state", "reason"],
      "properties": {
        "state": { "enum": ["exact", "partial", "unavailable", "not-applicable", "unknown"] },
        "reason": { "$ref": "#/$defs/string" },
        "source": {
          "enum": ["observability", "devtools", "snapshot", "instance", "network", "error"]
        },
        "scope": { "$ref": "#/$defs/string" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 4 },
        "runtimeVersion": { "type": "string" }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": ["observations"],
      "properties": {
        "observations": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/capability" }
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "maxBytes",
        "maxReports",
        "maxEvents",
        "maxSnapshots",
        "maxInstances",
        "maxNetworkRecords",
        "maxErrors",
        "maxStringLength",
        "maxDiagnosisStringLength",
        "maxDepth",
        "maxObjectKeys"
      ],
      "properties": {
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 26214400 },
        "maxReports": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxEvents": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "maxSnapshots": { "type": "integer", "minimum": 1, "maximum": 500 },
        "maxInstances": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxNetworkRecords": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "maxErrors": { "type": "integer", "minimum": 1, "maximum": 200 },
        "maxStringLength": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "maxDiagnosisStringLength": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "maxDepth": { "type": "integer", "minimum": 1, "maximum": 12 },
        "maxObjectKeys": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["captureId", "navigationId", "realmId", "sequence"],
      "properties": {
        "captureId": { "$ref": "#/$defs/string" },
        "navigationId": { "$ref": "#/$defs/string" },
        "realmId": { "$ref": "#/$defs/string" },
        "sequence": { "type": "integer", "minimum": 0 },
        "runtimeVersion": { "$ref": "#/$defs/string" },
        "sourceScope": { "$ref": "#/$defs/string" },
        "traceId": { "$ref": "#/$defs/string" },
        "requestId": { "$ref": "#/$defs/string" },
        "hostName": { "$ref": "#/$defs/string" },
        "instanceName": { "$ref": "#/$defs/string" },
        "remoteName": { "$ref": "#/$defs/string" },
        "remoteAlias": { "$ref": "#/$defs/string" },
        "sharedPackage": { "$ref": "#/$defs/string" }
      },
      "additionalProperties": false
    },
    "string": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "stringArray": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/string" } },
    "provenance": {
      "type": "object",
      "required": ["collector", "inputKind", "source", "sourceSchemaVersion"],
      "properties": {
        "collector": { "$ref": "#/$defs/nameVersion" },
        "inputKind": { "$ref": "#/$defs/string" },
        "source": { "$ref": "#/$defs/string" },
        "sourceSchemaVersion": { "$ref": "#/$defs/string" },
        "location": { "$ref": "#/$defs/string" },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "parentEvidenceIds": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/string" }
        }
      },
      "additionalProperties": false
    },
    "completeness": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["complete", "partial", "unknown", "not-collected"] },
        "expectedCount": { "type": "integer", "minimum": 0 },
        "observedCount": { "type": "integer", "minimum": 0 },
        "missing": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/string" } },
        "reason": { "$ref": "#/$defs/string" }
      },
      "additionalProperties": false
    },
    "recordBase": {
      "type": "object",
      "required": [
        "id",
        "identity",
        "source",
        "capturedAt",
        "contentDigest",
        "provenance",
        "completeness",
        "value"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "identity": { "$ref": "#/$defs/identity" },
        "source": { "type": "string", "minLength": 1, "maxLength": 32 },
        "capturedAt": { "type": "number", "minimum": 0 },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "completeness": { "$ref": "#/$defs/completeness" },
        "value": { "type": "object" }
      },
      "additionalProperties": false
    },
    "observabilityValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "traceId": { "$ref": "#/$defs/string" },
        "requestId": { "$ref": "#/$defs/string" },
        "requestAlias": { "$ref": "#/$defs/string" },
        "hostName": { "$ref": "#/$defs/string" },
        "runtimeVersion": { "$ref": "#/$defs/string" },
        "outcome": { "$ref": "#/$defs/string" },
        "phase": { "$ref": "#/$defs/string" },
        "errorCode": { "$ref": "#/$defs/string" },
        "ownerHint": { "$ref": "#/$defs/string" },
        "loadedBefore": { "type": "boolean" },
        "diagnosisTitle": { "$ref": "#/$defs/string" },
        "moduleInfoReason": { "$ref": "#/$defs/string" },
        "moduleInfoNames": { "$ref": "#/$defs/stringArray" }
      }
    },
    "devtoolsValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordId": { "$ref": "#/$defs/string" },
        "scope": { "$ref": "#/$defs/string" },
        "runtimeVersion": { "$ref": "#/$defs/string" },
        "reportIds": { "$ref": "#/$defs/stringArray" },
        "fields": { "$ref": "#/$defs/stringArray" }
      }
    },
    "snapshotValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/string" },
        "publicPath": { "$ref": "#/$defs/string" },
        "remoteEntry": { "$ref": "#/$defs/string" },
        "globalName": { "$ref": "#/$defs/string" },
        "availableNames": { "$ref": "#/$defs/stringArray" },
        "entryCount": { "type": "integer", "minimum": 0 }
      }
    },
    "instanceValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/string" },
        "hostName": { "$ref": "#/$defs/string" },
        "runtimeVersion": { "$ref": "#/$defs/string" },
        "remoteNames": { "$ref": "#/$defs/stringArray" },
        "shareScopes": { "$ref": "#/$defs/stringArray" }
      }
    },
    "networkValue": {
      "type": "object",
      "required": ["url", "kind"],
      "additionalProperties": false,
      "properties": {
        "url": { "$ref": "#/$defs/string" },
        "kind": { "enum": ["manifest", "remote-entry", "preload", "chunk", "unknown"] },
        "status": { "type": "integer", "minimum": 0, "maximum": 999 },
        "failureClass": { "$ref": "#/$defs/string" },
        "durationMs": { "type": "number", "minimum": 0 },
        "initiatorClass": { "$ref": "#/$defs/string" }
      }
    },
    "errorValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/string" },
        "name": { "$ref": "#/$defs/string" },
        "message": { "$ref": "#/$defs/string" },
        "phase": { "$ref": "#/$defs/string" },
        "runtimeVersion": { "$ref": "#/$defs/string" }
      }
    },
    "observabilityRecord": {
      "allOf": [
        { "$ref": "#/$defs/recordBase" },
        {
          "type": "object",
          "properties": {
            "source": { "const": "observability" },
            "value": { "$ref": "#/$defs/observabilityValue" }
          },
          "required": ["value"]
        }
      ]
    },
    "devtoolsRecord": {
      "allOf": [
        { "$ref": "#/$defs/recordBase" },
        {
          "type": "object",
          "properties": {
            "source": { "const": "devtools" },
            "value": { "$ref": "#/$defs/devtoolsValue" }
          },
          "required": ["value"]
        }
      ]
    },
    "snapshotRecord": {
      "allOf": [
        { "$ref": "#/$defs/recordBase" },
        {
          "type": "object",
          "properties": {
            "source": { "const": "snapshot" },
            "value": { "$ref": "#/$defs/snapshotValue" }
          },
          "required": ["value"]
        }
      ]
    },
    "instanceRecord": {
      "allOf": [
        { "$ref": "#/$defs/recordBase" },
        {
          "type": "object",
          "properties": {
            "source": { "const": "instance" },
            "value": { "$ref": "#/$defs/instanceValue" }
          },
          "required": ["value"]
        }
      ]
    },
    "networkRecord": {
      "allOf": [
        { "$ref": "#/$defs/recordBase" },
        {
          "type": "object",
          "properties": {
            "source": { "const": "network" },
            "value": { "$ref": "#/$defs/networkValue" }
          },
          "required": ["value"]
        }
      ]
    },
    "errorRecord": {
      "allOf": [
        { "$ref": "#/$defs/recordBase" },
        {
          "type": "object",
          "properties": {
            "source": { "const": "error" },
            "value": { "$ref": "#/$defs/errorValue" }
          },
          "required": ["value"]
        }
      ]
    },
    "observabilityRecords": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/observabilityRecord" }
    },
    "observabilityEventRecords": {
      "type": "array",
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/observabilityRecord" }
    },
    "devtoolsRecords": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/devtoolsRecord" }
    },
    "snapshotRecords": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/snapshotRecord" }
    },
    "instanceRecords": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/instanceRecord" }
    },
    "networkRecords": {
      "type": "array",
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/networkRecord" }
    },
    "errorRecords": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/errorRecord" }
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "truncation": {
      "type": "object",
      "required": ["collection", "dropped", "reason"],
      "properties": {
        "collection": {
          "enum": ["observability", "devtools", "snapshot", "instance", "network", "error", "total"]
        },
        "dropped": { "type": "integer", "minimum": 1 },
        "firstSequence": { "type": "integer", "minimum": 0 },
        "lastSequence": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": ["id", "from", "to", "relation", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "relation": {
          "enum": [
            "exact-id",
            "exact-safe-locator",
            "source-supplied",
            "time-window-candidate",
            "unknown"
          ]
        },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
