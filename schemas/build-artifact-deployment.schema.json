{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tonoizer/module-federation-doctor/schemas/build-artifact-deployment.schema.json",
  "title": "MFDoctor build artifact deployment correlation",
  "type": "object",
  "properties": { "schemaVersion": { "const": 1 } },
  "required": ["schemaVersion"],
  "oneOf": [
    { "$ref": "#/$defs/buildArtifactDeployment" },
    { "$ref": "#/$defs/deploymentRelationship" }
  ],
  "$defs": {
    "identityKey": {
      "type": "string",
      "pattern": "^mfid:v1:[a-z-]+:[a-f0-9]{24}$",
      "maxLength": 64
    },
    "buildKey": {
      "type": "string",
      "pattern": "^mfid:v1:build:[a-f0-9]{24}$",
      "maxLength": 64
    },
    "buildLineageKey": {
      "type": "string",
      "pattern": "^mfid:v1:build-lineage:[a-f0-9]{24}$",
      "maxLength": 64
    },
    "artifactKey": {
      "type": "string",
      "pattern": "^mfid:v1:artifact:[a-f0-9]{24}$",
      "maxLength": 64
    },
    "deploymentKey": {
      "type": "string",
      "pattern": "^mfid:v1:deployment:[a-f0-9]{24}$",
      "maxLength": 64
    },
    "environmentKey": {
      "type": "string",
      "pattern": "^mfid:v1:environment:[a-f0-9]{24}$",
      "maxLength": 64
    },
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*(?:[A-Za-z]:[\\\\/]|\\\\\\\\|^/|[a-z][a-z\\d+.-]*://|[?&](?:token|sig|signature|expires|auth|authorization|password|secret|credential|session|key)(?:=|&|$))).+$"
    },
    "outcome": { "enum": ["exact", "strong", "weak", "unknown"] },
    "completeness": { "enum": ["complete", "partial", "unknown"] },
    "confidence": { "enum": ["exact", "strong", "weak", "unknown"] },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/safeId" }
    },
    "buildArtifactDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "buildKey",
        "buildLineageKey",
        "artifactKeys",
        "deploymentKey",
        "environmentKey",
        "outcome",
        "completeness",
        "confidence",
        "matchedDimensions",
        "missing",
        "conflicts",
        "evidenceIds",
        "reason"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "build-artifact-deployment" },
        "buildKey": { "$ref": "#/$defs/buildKey" },
        "buildLineageKey": { "$ref": "#/$defs/buildLineageKey" },
        "artifactKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/artifactKey" }
        },
        "deploymentKey": { "$ref": "#/$defs/deploymentKey" },
        "environmentKey": { "$ref": "#/$defs/environmentKey" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "completeness": { "$ref": "#/$defs/completeness" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "matchedDimensions": { "$ref": "#/$defs/stringList" },
        "missing": { "$ref": "#/$defs/stringList" },
        "conflicts": { "$ref": "#/$defs/stringList" },
        "evidenceIds": { "$ref": "#/$defs/stringList" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "deploymentRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "deploymentKey",
        "relatedDeploymentKey",
        "environmentKey",
        "relation",
        "outcome",
        "completeness",
        "confidence",
        "matchedDimensions",
        "missing",
        "conflicts",
        "evidenceIds",
        "reason"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "deployment-relationship" },
        "deploymentKey": { "$ref": "#/$defs/deploymentKey" },
        "relatedDeploymentKey": { "$ref": "#/$defs/deploymentKey" },
        "environmentKey": { "$ref": "#/$defs/environmentKey" },
        "relation": { "enum": ["redeploy", "rollback"] },
        "outcome": { "$ref": "#/$defs/outcome" },
        "completeness": { "$ref": "#/$defs/completeness" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "matchedDimensions": { "$ref": "#/$defs/stringList" },
        "missing": { "$ref": "#/$defs/stringList" },
        "conflicts": { "$ref": "#/$defs/stringList" },
        "evidenceIds": { "$ref": "#/$defs/stringList" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
