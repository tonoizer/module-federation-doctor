{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://module-federation.github.io/doctor/schemas/rule-inventory.schema.json",
  "title": "Module Federation Doctor rule migration inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedFrom",
    "ruleCount",
    "migratedCount",
    "compatibilityExceptionCount",
    "compatibilityExceptions",
    "rules"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedFrom": { "type": "string", "minLength": 1 },
    "ruleCount": { "type": "integer", "minimum": 1 },
    "migratedCount": { "type": "integer", "minimum": 0 },
    "compatibilityExceptionCount": { "type": "integer", "minimum": 0 },
    "compatibilityExceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/compatibilityException" }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ruleEntry" }
    }
  },
  "$defs": {
    "compatibilityException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "reason", "scope", "deprecationPlan"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "contact": { "type": "string" }
          }
        },
        "reason": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "deprecationPlan": { "type": "string", "minLength": 1 }
      }
    },
    "ruleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "group",
        "status",
        "defaultSeverity",
        "confidenceCeiling",
        "owner",
        "remediation",
        "prerequisites",
        "applicability",
        "evidenceReads",
        "migrationNote"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "group": { "type": "integer", "minimum": 0, "maximum": 6 },
        "status": { "enum": ["legacy", "migrated"] },
        "defaultSeverity": { "enum": ["error", "warning", "info"] },
        "confidenceCeiling": {
          "enum": ["exact", "high", "medium", "low", "unknown"]
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "contact": { "type": "string" }
          }
        },
        "remediation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "documentation"],
          "properties": {
            "summary": { "type": "string", "minLength": 1 },
            "documentation": { "type": "string", "minLength": 1 },
            "fix": { "type": "string" }
          }
        },
        "prerequisites": { "type": "object" },
        "applicability": { "type": "object" },
        "evidenceReads": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "migrationNote": { "type": "string", "minLength": 1 }
      }
    }
  }
}
