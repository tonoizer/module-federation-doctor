{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tonoizer/module-federation-doctor/schemas/runtime-trace.schema.json",
  "title": "Module Federation Doctor runtime trace correlation summary",
  "type": "object",
  "required": ["schemaVersion", "traces", "projects", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "traces": { "type": "integer", "minimum": 1 },
    "projects": { "type": "integer", "minimum": 1 },
    "findings": { "type": "integer", "minimum": 0 },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schemaVersion", "events"],
        "properties": {
          "schemaVersion": { "const": 1 },
          "traceId": { "type": "string" },
          "status": { "type": "string" },
          "errorCode": { "type": "string" },
          "outcome": { "type": "string" },
          "remote": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "alias": { "type": "string" },
              "entry": { "type": "string" }
            },
            "additionalProperties": false
          },
          "shared": {
            "type": "object",
            "properties": {
              "package": { "type": "string" },
              "provider": { "type": "string" },
              "requiredVersion": { "type": "string" },
              "selectedVersion": { "type": "string" },
              "availableVersions": {
                "type": "array",
                "items": { "type": "string" }
              },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          },
          "moduleInfo": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "id": { "type": "string" },
              "publicPath": { "type": "string" }
            },
            "additionalProperties": false
          },
          "phases": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "status": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "phase": { "type": "string" },
                "status": { "type": "string" },
                "errorCode": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "diagnosis": {
            "type": "object",
            "properties": {
              "owner": { "type": "string" },
              "summary": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
