{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tonoizer/module-federation-doctor/schemas/runtime-trace.schema.json",
  "title": "Module Federation Doctor runtime trace correlation summary",
  "type": "object",
  "required": ["schemaVersion", "traces", "projects", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "traces": { "type": "integer", "minimum": 1 },
    "projects": { "type": "integer", "minimum": 1 },
    "findings": { "type": "integer", "minimum": 0 },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schemaVersion", "events"],
        "properties": {
          "schemaVersion": { "const": 1 },
          "traceId": { "type": "string" },
          "sourceContract": {
            "enum": ["upstream-observability-2.5.3", "legacy-doctor-v1", "partial"]
          },
          "sharedCompleteness": {
            "enum": ["complete", "partial", "unknown"]
          },
          "status": { "type": "string" },
          "requestId": { "type": "string" },
          "requestAlias": { "type": "string" },
          "hostName": { "type": "string" },
          "runtimeVersion": { "type": "string" },
          "errorCode": { "type": "string" },
          "errorName": { "type": "string" },
          "errorMessage": { "type": "string" },
          "retryable": { "type": "boolean" },
          "errorContext": { "type": "object", "additionalProperties": true },
          "failedPhase": { "type": "string" },
          "ownerHint": { "type": "string" },
          "ownerHints": { "type": "array", "items": { "type": "string" } },
          "ownerHintConflict": { "type": "boolean" },
          "outcome": { "type": "string" },
          "recovered": { "type": "boolean" },
          "loadedBefore": {
            "anyOf": [
              { "type": "boolean" },
              {
                "type": "object",
                "properties": {
                  "producer": { "type": "boolean" },
                  "expose": { "type": "boolean" },
                  "consumers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": { "type": "string" },
                        "remoteEntryExports": { "type": "boolean" },
                        "containerInitialized": { "type": "boolean" },
                        "exposes": { "type": "array", "items": { "type": "string" } }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "loadCompleted": { "type": "boolean" },
          "runtimeLoaded": { "type": "boolean" },
          "sharedResolved": { "type": "boolean" },
          "preloaded": { "type": "boolean" },
          "componentLoaded": { "type": "boolean" },
          "lastPhase": { "type": "string" },
          "flags": { "type": "object", "additionalProperties": { "type": "boolean" } },
          "remote": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "alias": { "type": "string" },
              "entry": { "type": "string" }
            },
            "additionalProperties": false
          },
          "shared": {
            "type": "object",
            "properties": {
              "package": { "type": "string" },
              "provider": { "type": "string" },
              "requiredVersion": {
                "anyOf": [{ "type": "string" }, { "const": false }]
              },
              "selectedVersion": { "type": "string" },
              "availableVersions": {
                "type": "array",
                "items": { "type": "string" }
              },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          },
          "moduleInfo": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "id": { "type": "string" },
              "publicPath": { "type": "string" },
              "reason": { "type": "string" },
              "clipped": { "type": "boolean" },
              "totalCount": { "type": "number" },
              "matchedCount": { "type": "number" },
              "availableNames": { "type": "array", "items": { "type": "string" } },
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "publicPath": { "type": "string" },
                    "getPublicPath": { "type": "string" },
                    "remoteEntry": { "type": "string" },
                    "globalName": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "phases": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "status": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "phase": { "type": "string" },
                "status": { "type": "string" },
                "errorCode": { "type": "string" },
                "retryable": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "diagnosis": {
            "type": "object",
            "properties": {
              "owner": { "type": "string" },
              "ownerHint": { "type": "string" },
              "title": { "type": "string" },
              "summary": { "type": "string" },
              "outcome": { "type": "string" },
              "status": { "type": "string" },
              "errorCode": { "type": "string" },
              "failedPhase": { "type": "string" },
              "errorName": { "type": "string" },
              "errorMessage": { "type": "string" },
              "docLink": { "type": "string" },
              "facts": { "type": "object", "additionalProperties": true },
              "actions": {
                "type": "array",
                "items": { "type": "object", "additionalProperties": true }
              },
              "warnings": { "type": "array", "items": { "type": "string" } },
              "completedPhases": { "type": "array", "items": { "type": "string" } },
              "pendingPhases": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
