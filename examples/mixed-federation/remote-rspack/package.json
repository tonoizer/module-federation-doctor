{
  "name": "@mfdoctor-example/remote-rspack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rspack build",
    "dev": "rspack serve",
    "preview": "node ../../../scripts/serve-dist.mjs dist 3001",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@module-federation/enhanced": "2.8.0",
    "@mfdoctor-example/shared-ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@module-federation/doctor": "workspace:*",
    "@rspack/cli": "2.1.5",
    "@rspack/core": "2.1.5",
    "@rspack/dev-server": "2.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
