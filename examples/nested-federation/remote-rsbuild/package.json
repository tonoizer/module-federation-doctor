{
  "name": "@mfdoctor-example/nested-remote-rsbuild",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rsbuild build",
    "dev": "rsbuild dev --host 127.0.0.1 --port 3011",
    "preview": "rsbuild preview --host 127.0.0.1 --port 3011",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@module-federation/rsbuild-plugin": "2.8.2",
    "@mfdoctor-example/nested-shared-ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tonoizer/mfdoctor": "workspace:*",
    "@rsbuild/core": "2.1.8",
    "@rsbuild/plugin-react": "2.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
