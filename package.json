{
  "name": "@tonoizer/mfdoctor",
  "version": "1.1.0",
  "description": "Module Federation diagnostics for Vite, Rolldown/Vite Plus, Rspack, Rsbuild, Webpack, and Modern.js",
  "type": "module",
  "bin": {
    "mfdoctor": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": {
        "import": "./dist/vite.d.ts",
        "require": "./dist/vite.d.cts"
      },
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs",
      "default": "./dist/vite.js"
    },
    "./nuxt": {
      "types": {
        "import": "./dist/nuxt.d.ts",
        "require": "./dist/nuxt.d.cts"
      },
      "import": "./dist/nuxt.js",
      "require": "./dist/nuxt.cjs",
      "default": "./dist/nuxt.js"
    },
    "./rspack": {
      "types": {
        "import": "./dist/rspack.d.ts",
        "require": "./dist/rspack.d.cts"
      },
      "import": "./dist/rspack.js",
      "require": "./dist/rspack.cjs",
      "default": "./dist/rspack.js"
    },
    "./rsbuild": {
      "types": {
        "import": "./dist/rsbuild.d.ts",
        "require": "./dist/rsbuild.d.cts"
      },
      "import": "./dist/rsbuild.js",
      "require": "./dist/rsbuild.cjs",
      "default": "./dist/rsbuild.js"
    },
    "./webpack": {
      "types": {
        "import": "./dist/webpack.d.ts",
        "require": "./dist/webpack.d.cts"
      },
      "import": "./dist/webpack.js",
      "require": "./dist/webpack.cjs",
      "default": "./dist/webpack.js"
    },
    "./modern": {
      "types": {
        "import": "./dist/modern.d.ts",
        "require": "./dist/modern.d.cts"
      },
      "import": "./dist/modern.js",
      "require": "./dist/modern.cjs",
      "default": "./dist/modern.js"
    },
    "./rules": {
      "types": {
        "import": "./dist/rules.d.ts",
        "require": "./dist/rules.d.cts"
      },
      "import": "./dist/rules.js",
      "require": "./dist/rules.cjs",
      "default": "./dist/rules.js"
    },
    "./policy": {
      "types": {
        "import": "./dist/policy.d.ts",
        "require": "./dist/policy.d.cts"
      },
      "import": "./dist/policy.js",
      "require": "./dist/policy.cjs",
      "default": "./dist/policy.js"
    },
    "./capture": {
      "types": {
        "import": "./dist/capture.d.ts",
        "require": "./dist/capture.d.cts"
      },
      "import": "./dist/capture.js",
      "require": "./dist/capture.cjs",
      "default": "./dist/capture.js"
    },
    "./schemas/project.schema.json": "./schemas/project.schema.json",
    "./schemas/report.schema.json": "./schemas/report.schema.json",
    "./schemas/baseline.schema.json": "./schemas/baseline.schema.json",
    "./schemas/probe.schema.json": "./schemas/probe.schema.json",
    "./schemas/compare.schema.json": "./schemas/compare.schema.json",
    "./schemas/runtime-trace.schema.json": "./schemas/runtime-trace.schema.json",
    "./schemas/identity.schema.json": "./schemas/identity.schema.json",
    "./schemas/config.schema.json": "./schemas/config.schema.json",
    "./schemas/runtime-capture.schema.json": "./schemas/runtime-capture.schema.json",
    "./schemas/runtime-identity-correlation.schema.json": "./schemas/runtime-identity-correlation.schema.json",
    "./schemas/build-artifact-deployment.schema.json": "./schemas/build-artifact-deployment.schema.json",
    "./schemas/finding-lineage.schema.json": "./schemas/finding-lineage.schema.json",
    "./schemas/governance-waiver.schema.json": "./schemas/governance-waiver.schema.json",
    "./schemas/identity-correlation.schema.json": "./schemas/identity-correlation.schema.json",
    "./schemas/identity-governance.schema.json": "./schemas/identity-governance.schema.json",
    "./schemas/semantic-graph.schema.json": "./schemas/semantic-graph.schema.json",
    "./schemas/ui.schema.json": "./schemas/ui.schema.json",
    "./schemas/evidence.schema.json": "./schemas/evidence.schema.json",
    "./schemas/rule-inventory.schema.json": "./schemas/rule-inventory.schema.json",
    "./schemas/capabilities.schema.json": "./schemas/capabilities.schema.json",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "vite": [
        "dist/vite.d.ts"
      ],
      "nuxt": [
        "dist/nuxt.d.ts"
      ],
      "rspack": [
        "dist/rspack.d.ts"
      ],
      "rsbuild": [
        "dist/rsbuild.d.ts"
      ],
      "webpack": [
        "dist/webpack.d.ts"
      ],
      "modern": [
        "dist/modern.d.ts"
      ],
      "rules": [
        "dist/rules.d.ts"
      ],
      "policy": [
        "dist/policy.d.ts"
      ],
      "capture": [
        "dist/capture.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "schemas",
    "fixtures/compatibility-matrix.json",
    "skills",
    "AGENTS.md",
    "examples/ci/github-actions-mfdoctor.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonoizer/module-federation-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/tonoizer/module-federation-doctor/issues"
  },
  "homepage": "https://mfdoctor.kevinbeier.com/",
  "author": "Kevin Beier",
  "keywords": [
    "module-federation",
    "vite",
    "rspack",
    "rsbuild",
    "webpack",
    "modern.js",
    "diagnostics",
    "sarif"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "husky",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "clean": "node -e \"import('node:fs').then(fs=>{for(const p of ['dist','.mf','coverage'])fs.rmSync(p,{recursive:true,force:true})})\" && vp run --filter './apps/docs' --filter './examples/**' clean",
    "fmt": "vp fmt .",
    "fmt:check": "vp fmt --check .",
    "lint": "vp lint --deny-warnings .",
    "typecheck": "vp exec tsc -p tsconfig.json && vp run --filter './apps/docs' --filter './examples/**' typecheck",
    "test": "vp run --filter . test:unit && vp run --filter . test:integration && vp run --filter . test:e2e",
    "test:unit": "vp test run test/unit",
    "test:integration": "vp test run test/integration",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:giga": "vp run --filter . test:e2e",
    "test:examples": "vp run --filter './examples/mixed-federation/**' build",
    "test:nested": "vp run --filter './examples/nested-federation/**' build && node dist/cli.js workspace examples/nested-federation --format terminal,json",
    "demo:showcase": "vp run --filter . build && node scripts/demo-showcase.mjs",
    "demo:mixed-issues": "vp run --filter . build && node scripts/demo-mixed-issues.mjs",
    "demo:standalone": "vp run --filter . build && node scripts/demo-standalone-findings.mjs",
    "demo:nested": "vp run --filter . build && node scripts/demo-nested.mjs",
    "demo:examples": "vp run --filter @mfdoctor-example/demos demo",
    "docs:dev": "vp run --filter @tonoizer/mfdoctor-docs dev",
    "docs:build": "vp run --filter @tonoizer/mfdoctor-docs build",
    "pack:check": "vp run --filter . build && vp exec publint run --pack npm . && vp exec attw --pack . --profile esm-only && vp run schema:check && node scripts/verify-runtime-capture-compatibility.mjs && node scripts/verify-semantic-graph.mjs && node scripts/pack-check.mjs",
    "changeset:check": "node scripts/changeset-contract.mjs",
    "schema:check": "node --experimental-strip-types scripts/schema-contract.mjs",
    "evidence:drift": "vp run --filter . build && node scripts/evidence-drift-check.mjs",
    "inventory:generate": "vp run --filter . build && node scripts/generate-rule-inventory.mjs",
    "inventory:check": "vp run --filter . build && node scripts/generate-rule-inventory.mjs --check",
    "benchmark:analysis": "vp run --filter . build && node scripts/benchmark-analysis-cost.mjs",
    "check": "vp run --filter . fmt:check && vp run --filter . lint && vp run --filter . changeset:check && vp run --filter . build && vp run --filter . typecheck && vp run --filter . test:unit && vp run --filter . test:integration && vp run --filter . inventory:check && vp run --filter . demo:showcase && vp run --filter . test:e2e && vp run --filter . docs:build && vp run --filter . pack:check",
    "changeset": "changeset",
    "version": "changeset version",
    "release:dry-run": "vp run --filter . pack:check && npm publish --dry-run --provenance --access public"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fast-glob": "3.3.3",
    "oxc-parser": "0.141.0",
    "picocolors": "1.1.1",
    "semver": "7.8.5",
    "unconfig": "7.5.0",
    "unplugin": "3.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/semver": "7.8.0",
    "ajv-formats": "3.0.1",
    "husky": "9.1.7",
    "playwright": "1.62.1",
    "publint": "0.3.23",
    "typescript": "5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9",
    "vitest": "4.1.10"
  }
}
