{
  "name": "@module-federation/doctor",
  "version": "0.1.0",
  "description": "Module Federation diagnostics for Vite, Rolldown/Vite Plus, Rspack, Rsbuild, Webpack, and Modern.js",
  "type": "module",
  "bin": {
    "mfdoctor": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js",
      "default": "./dist/nuxt.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "import": "./dist/rspack.js",
      "default": "./dist/rspack.js"
    },
    "./rsbuild": {
      "types": "./dist/rsbuild.d.ts",
      "import": "./dist/rsbuild.js",
      "default": "./dist/rsbuild.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.js",
      "default": "./dist/webpack.js"
    },
    "./modern": {
      "types": "./dist/modern.d.ts",
      "import": "./dist/modern.js",
      "default": "./dist/modern.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "import": "./dist/rules.js",
      "default": "./dist/rules.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js",
      "default": "./dist/policy.js"
    },
    "./capture": {
      "types": "./dist/capture.d.ts",
      "import": "./dist/capture.js",
      "default": "./dist/capture.js"
    },
    "./schemas/project.schema.json": "./schemas/project.schema.json",
    "./schemas/report.schema.json": "./schemas/report.schema.json",
    "./schemas/baseline.schema.json": "./schemas/baseline.schema.json",
    "./schemas/probe.schema.json": "./schemas/probe.schema.json",
    "./schemas/runtime-trace.schema.json": "./schemas/runtime-trace.schema.json",
    "./schemas/identity.schema.json": "./schemas/identity.schema.json",
    "./schemas/config.schema.json": "./schemas/config.schema.json",
    "./schemas/runtime-capture.schema.json": "./schemas/runtime-capture.schema.json",
    "./schemas/ui.schema.json": "./schemas/ui.schema.json",
    "./schemas/evidence.schema.json": "./schemas/evidence.schema.json",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonoizer/module-federation-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/tonoizer/module-federation-doctor/issues"
  },
  "homepage": "https://github.com/tonoizer/module-federation-doctor#readme",
  "keywords": [
    "module-federation",
    "vite",
    "rspack",
    "rsbuild",
    "webpack",
    "modern.js",
    "diagnostics",
    "sarif"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "node -e \"import('node:fs').then(fs=>{for(const p of ['dist','.mf','coverage'])fs.rmSync(p,{recursive:true,force:true})})\" && corepack pnpm --filter './apps/docs' --filter './examples/**' clean",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc -p tsconfig.json && corepack pnpm --filter './apps/docs' --filter './examples/**' typecheck",
    "test": "corepack pnpm test:unit && corepack pnpm test:integration && corepack pnpm test:e2e",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "corepack pnpm build && corepack pnpm test:examples && corepack pnpm --filter './examples/mixed-federation-issues/**' build && corepack pnpm exec playwright test",
    "test:giga": "corepack pnpm build && node scripts/giga-smoke.mjs && corepack pnpm exec playwright test",
    "test:examples": "corepack pnpm --filter './examples/mixed-federation/**' build",
    "test:nested": "corepack pnpm --filter './examples/nested-federation/**' build && node dist/cli.js workspace examples/nested-federation --format terminal,json",
    "demo:showcase": "corepack pnpm build && node scripts/demo-showcase.mjs",
    "demo:mixed-issues": "corepack pnpm build && node scripts/demo-mixed-issues.mjs",
    "demo:standalone": "corepack pnpm build && node scripts/demo-standalone-findings.mjs",
    "demo:nested": "corepack pnpm build && node scripts/demo-nested.mjs",
    "demo:examples": "corepack pnpm --filter @mfdoctor-example/demos demo",
    "docs:dev": "corepack pnpm --filter @module-federation/doctor-docs dev",
    "docs:build": "corepack pnpm --filter @module-federation/doctor-docs build",
    "pack:check": "corepack pnpm build && publint && attw --pack . --profile esm-only && corepack pnpm schema:check && node scripts/pack-check.mjs",
    "changeset:check": "node scripts/changeset-contract.mjs",
    "schema:check": "node --experimental-strip-types scripts/schema-contract.mjs",
    "evidence:drift": "corepack pnpm build && node scripts/evidence-drift-check.mjs",
    "benchmark:analysis": "corepack pnpm build && node scripts/benchmark-analysis-cost.mjs",
    "check": "corepack pnpm fmt:check && corepack pnpm lint && corepack pnpm changeset:check && corepack pnpm build && corepack pnpm typecheck && corepack pnpm test:unit && corepack pnpm test:integration && corepack pnpm demo:showcase && corepack pnpm test:e2e && corepack pnpm docs:build && corepack pnpm pack:check",
    "changeset": "changeset",
    "version": "changeset version",
    "release:dry-run": "corepack pnpm pack:check && npm publish --dry-run --provenance --access public"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fast-glob": "3.3.3",
    "oxc-parser": "0.141.0",
    "picocolors": "1.1.1",
    "semver": "7.8.5",
    "unconfig": "7.5.0",
    "unplugin": "3.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@types/semver": "7.7.1",
    "ajv-formats": "3.0.1",
    "husky": "9.1.7",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "playwright": "1.61.1",
    "publint": "0.3.22",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
