{
  "schemaVersion": 1,
  "project": {
    "name": "ssr_remote",
    "root": "."
  },
  "bundler": {
    "name": "rspack",
    "mode": "ci"
  },
  "capabilities": {
    "config": true,
    "sourceImports": true,
    "manifest": false,
    "stats": false,
    "emittedAssets": true,
    "installedVersions": true
  },
  "moduleFederation": {
    "name": "ssr_remote",
    "filename": "remoteEntry.js",
    "exposes": {
      "./render": "./src/render.tsx"
    },
    "remotes": {},
    "shared": {
      "react": {
        "package": "react",
        "singleton": true,
        "eager": false,
        "shareScope": ["default"]
      },
      "react-dom": {
        "package": "react-dom",
        "singleton": true,
        "eager": false,
        "shareScope": ["default"]
      },
      "react-dom/server": {
        "package": "react-dom/server",
        "singleton": true,
        "eager": false,
        "shareScope": ["default"]
      }
    },
    "experiments": {
      "asyncStartup": false,
      "externalRuntime": false,
      "provideExternalRuntime": false,
      "target": "node"
    },
    "library": {
      "type": "commonjs-module"
    },
    "dts": {
      "enabled": false,
      "options": {}
    }
  },
  "dependencies": {
    "declared": {
      "react": "^19.1.0",
      "react-dom": "^19.1.0"
    },
    "installed": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    }
  },
  "imports": {
    "sourceFiles": ["src/render.tsx"],
    "specifiers": ["react-dom/server"],
    "packages": ["react-dom"],
    "dynamicPackages": [],
    "remotes": [],
    "unresolvedDynamic": [],
    "deepImports": ["react-dom/server"],
    "deepImportFiles": {
      "react-dom": ["src/render.tsx"]
    },
    "evidenceSources": ["source"]
  },
  "artifacts": {
    "emittedAssets": ["remoteEntry.js", "render.js"]
  },
  "builds": [
    {
      "id": "ssr",
      "adapter": "rspack",
      "bundler": "rspack",
      "emittedAssets": ["remoteEntry.js", "render.js"],
      "artifacts": [],
      "target": "node",
      "targetKind": "ssr",
      "capabilities": {
        "outputRoot": { "state": "exact", "reason": "fixture" },
        "emittedAssets": { "state": "exact", "reason": "fixture" },
        "artifacts": { "state": "exact", "reason": "fixture" },
        "effectiveMode": { "state": "exact", "reason": "fixture" },
        "target": { "state": "exact", "reason": "fixture" }
      },
      "sourceHook": "fixture"
    }
  ]
}
