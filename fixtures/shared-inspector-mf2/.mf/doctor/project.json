{
  "schemaVersion": 1,
  "project": {
    "name": "shell",
    "root": "."
  },
  "bundler": {
    "name": "rspack",
    "mode": "ci"
  },
  "capabilities": {
    "config": true,
    "sourceImports": false,
    "manifest": true,
    "stats": false,
    "emittedAssets": false,
    "installedVersions": true
  },
  "moduleFederation": {
    "name": "shell",
    "exposes": {},
    "remotes": {
      "checkout": {
        "name": "checkout",
        "entry": "https://example.com/checkout/mf-manifest.json",
        "alias": "checkout",
        "shareScope": ["default"]
      }
    },
    "shared": {
      "react": {
        "package": "react",
        "singleton": true,
        "eager": false,
        "requiredVersion": "^18.2.0",
        "shareScope": ["default"]
      },
      "react-dom": {
        "package": "react-dom",
        "singleton": true,
        "eager": false,
        "requiredVersion": "^18.2.0",
        "shareScope": ["default"]
      },
      "zustand": {
        "package": "zustand",
        "singleton": true,
        "eager": false,
        "requiredVersion": "^4.5.0",
        "shareScope": ["default"]
      }
    }
  },
  "dependencies": {
    "declared": {
      "react": "^18.2.0",
      "react-dom": "^18.2.0",
      "zustand": "^4.5.0"
    },
    "installed": {
      "react": "18.2.0",
      "react-dom": "18.2.0",
      "zustand": "4.5.0"
    }
  },
  "imports": {
    "sourceFiles": [],
    "specifiers": [],
    "packages": [],
    "dynamicPackages": [],
    "remotes": ["checkout"],
    "unresolvedDynamic": [],
    "evidenceSources": ["manifest"]
  },
  "artifacts": {
    "manifest": {
      "path": "shell.mf-manifest.json",
      "valid": true,
      "remoteEntry": { "name": "remoteEntry.js", "path": "" },
      "exposes": [],
      "shared": [
        { "name": "react", "version": "18.2.0", "requiredVersion": "^18.2.0", "singleton": true, "assets": [] },
        { "name": "react-dom", "version": "18.2.0", "requiredVersion": "^18.2.0", "singleton": true, "assets": [] },
        { "name": "zustand", "version": "4.5.0", "requiredVersion": "^4.5.0", "singleton": true, "assets": [] }
      ],
      "remotes": [
        {
          "name": "checkout",
          "alias": "checkout",
          "entry": "https://example.com/checkout/mf-manifest.json"
        }
      ]
    },
    "emittedAssets": []
  }
}
