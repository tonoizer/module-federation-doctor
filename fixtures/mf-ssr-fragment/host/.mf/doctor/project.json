{
  "schemaVersion": 1,
  "project": {
    "name": "host",
    "root": "."
  },
  "bundler": {
    "name": "vite",
    "mode": "ci"
  },
  "capabilities": {
    "config": true,
    "sourceImports": true,
    "manifest": false,
    "stats": false,
    "emittedAssets": false,
    "installedVersions": true
  },
  "moduleFederation": {
    "name": "host",
    "exposes": {},
    "remotes": {
      "checkout": {
        "name": "checkout",
        "entry": "https://checkout.example.com/api/fragments/checkout",
        "alias": "checkout",
        "type": "mf-ssr-fragment",
        "shareScope": ["default"]
      },
      "checkoutRelative": {
        "name": "checkoutRelative",
        "entry": "/api/fragments/checkout",
        "alias": "checkoutRelative",
        "type": "mf-ssr-fragment",
        "shareScope": ["default"]
      }
    },
    "shared": {
      "react": {
        "package": "react",
        "singleton": true,
        "eager": false,
        "requiredVersion": "^19.1.0",
        "shareScope": ["default"]
      }
    }
  },
  "dependencies": {
    "declared": {
      "react": "^19.1.0"
    },
    "installed": {
      "react": "19.2.8"
    }
  },
  "imports": {
    "sourceFiles": ["src/CheckoutSlot.tsx"],
    "specifiers": [],
    "packages": [],
    "dynamicPackages": [],
    "remotes": ["checkout"],
    "unresolvedDynamic": [],
    "evidenceSources": ["source"]
  },
  "artifacts": {
    "emittedAssets": []
  }
}
