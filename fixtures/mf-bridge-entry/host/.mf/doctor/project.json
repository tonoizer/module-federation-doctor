{
  "schemaVersion": 1,
  "project": {
    "name": "host",
    "root": "."
  },
  "bundler": {
    "name": "vite",
    "mode": "ci"
  },
  "capabilities": {
    "config": true,
    "sourceImports": true,
    "manifest": false,
    "stats": false,
    "emittedAssets": false,
    "installedVersions": true
  },
  "moduleFederation": {
    "name": "host",
    "exposes": {},
    "remotes": {
      "remote": {
        "name": "remote",
        "entry": "http://localhost:3001/mf-manifest.json",
        "alias": "remote",
        "shareScope": ["default"]
      }
    },
    "shared": {
      "react": {
        "package": "react",
        "singleton": true,
        "eager": false,
        "requiredVersion": "^19.1.0",
        "shareScope": ["default"]
      }
    }
  },
  "dependencies": {
    "declared": {
      "react": "^19.1.0"
    },
    "installed": {
      "react": "19.2.8"
    }
  },
  "imports": {
    "sourceFiles": ["src/HostSlot.tsx"],
    "specifiers": [],
    "packages": [],
    "dynamicPackages": [],
    "remotes": ["remote"],
    "unresolvedDynamic": [],
    "evidenceSources": ["source"]
  },
  "artifacts": {
    "emittedAssets": []
  }
}
